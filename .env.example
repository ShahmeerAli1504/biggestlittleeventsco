# Copy to .env.local for local dev; add the same keys in Vercel → Project → Settings → Environment Variables.

# ---------- Gmail SMTP (used by the Go serverless function /api/inquiry) ----------
# The Gmail / Google Workspace account that sends the mail.
GMAIL_USER=bookings@gmail.com
# 16-character App Password (Google Account → Security → 2-Step Verification → App passwords).
# Your regular Google password will NOT work.
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
# Inbox(es) that receive new inquiries, comma-separated. Defaults to GMAIL_USER.
MAIL_TO=
# Display name on outgoing email.
MAIL_FROM_NAME=Biggest Little Events Co
# Send the client an instant confirmation email ("Email 1"). true / false
SEND_AUTORESPONSE=true
# Optional: only accept form posts from these origins (comma-separated).
ALLOWED_ORIGINS=
# Optional overrides (defaults shown). Use 465 for implicit TLS.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# ---------- Public site details (shown on the website; empty = hidden) ----------
NEXT_PUBLIC_SITE_URL=https://biggestlittleeventsco.com
NEXT_PUBLIC_PHONE_DISPLAY=
NEXT_PUBLIC_PHONE_TEL=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_INSTAGRAM_EVENTS=
